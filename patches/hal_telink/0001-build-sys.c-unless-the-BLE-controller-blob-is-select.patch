From 350af0d4e290963fafa33107f618ad866dad10b0 Mon Sep 17 00:00:00 2001
From: scholzri <33288574+scholzri@users.noreply.github.com>
Date: Mon, 5 Oct 2026 19:44:51 +0200
Subject: [PATCH] build sys.c unless the BLE controller blob is selected

The Telink BLE controller blob (BT_HCI_B91_CTLR_BLOB) ships its own
sys_init(), which collides with the one in drivers/B91/sys.c. The open
controller (BT_HCI_B91_CTLR_OPEN) needs hal sys.c (g_chip_version, used
by pm.c). Exclude sys.c for the blob only, as already done for BT_B91.
---
 tlsr9/CMakeLists.txt | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/tlsr9/CMakeLists.txt b/tlsr9/CMakeLists.txt
index 0f44f47..c70b678 100644
--- a/tlsr9/CMakeLists.txt
+++ b/tlsr9/CMakeLists.txt
@@ -12,7 +12,7 @@ zephyr_include_directories(drivers/B91/reg_include)
 zephyr_include_directories(drivers/B91)
 
 # soc.c referance sources
-if (NOT CONFIG_PM AND NOT CONFIG_BT_B91)
+if (NOT CONFIG_PM AND NOT CONFIG_BT_B91 AND NOT CONFIG_BT_HCI_B91_CTLR_BLOB)
 zephyr_library_sources(drivers/B91/sys.c)
 endif() # no PM and no BLE external dependency
 zephyr_library_sources(drivers/B91/pm.c)
-- 
2.53.0

