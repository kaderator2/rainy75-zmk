From 0749e853c399094585bc8b66ecc746f93a31ade2 Mon Sep 17 00:00:00 2001
From: scholzri <33288574+scholzri@users.noreply.github.com>
Date: Mon, 5 Oct 2026 16:37:16 +0200
Subject: [PATCH] zmk: keep passkey entry keys out of the HID reports

Event listeners run in link order (the .event_subscription section is
not sorted), and hid_listener.c is linked before ble.c. So every key
typed for a passkey was first reported to the host by hid_listener and
only then consumed by the passkey listener in ble.c: the digits showed
up on the USB host (the endpoint falls back to USB while the new
profile is not connected yet) or on another BLE host.

Add zmk_ble_passkey_entry_active() and check it in hid_listener: from
the passkey request until that pairing completes, fails, is cancelled
or its connection drops, drop presses and drop releases of keys that
are not in the report. Releases of keys held from before the request
still go out, so no key gets stuck. This does not depend on listener
order.

The passkey listener stops collecting at the Enter release, but the
host still checks the passkey after that. Without the longer window a
second Enter typed while the host was busy reached the PC. A separate
reference (auth_pairing_keys_conn, atomic: set and cleared from the BT
RX thread, read from the key thread) holds the pairing until its end.

auth_passkey_entry_conn becomes atomic too and every end of the
pairing clears it: Zephyr calls the cancel callback only for a remote
Pairing Failed, while Esc (local cancel), the SMP timeout and a
disconnect before Enter only call pairing_failed / security_changed.
Before, it stayed set on those paths and, with the check above, kept
every key away from the hosts until the next pairing. Enter and Esc in
the key thread take it with an atomic exchange, so it is never dropped
twice. A disconnect that ends a pairing nothing else ended raises
FAILED. A digit raises PASSKEY_DIGITS only if the entry is still
open, so a digit typed while the RX thread ends the pairing does not
restart the guidance after its FAILED.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 app/include/zmk/ble.h  |   6 +++
 app/src/ble.c          | 103 ++++++++++++++++++++++++++++++++++-------
 app/src/hid_listener.c |  22 ++++++++-
 3 files changed, 112 insertions(+), 19 deletions(-)

diff --git a/app/include/zmk/ble.h b/app/include/zmk/ble.h
index 92b2107d..7337bc39 100644
--- a/app/include/zmk/ble.h
+++ b/app/include/zmk/ble.h
@@ -38,6 +38,12 @@ bool zmk_ble_profile_is_open(uint8_t index);
 
 bool zmk_ble_active_profile_is_open(void);
 bool zmk_ble_active_profile_is_connected(void);
+
+#if IS_ENABLED(CONFIG_ZMK_BLE_PASSKEY_ENTRY)
+// True from the passkey request until that pairing completes, fails, is cancelled or its
+// connection drops: keys go to the passkey (or nowhere while the host checks it), not to a host.
+bool zmk_ble_passkey_entry_active(void);
+#endif
 char *zmk_ble_active_profile_name(void);
 
 int zmk_ble_unpair_all(void);
diff --git a/app/src/ble.c b/app/src/ble.c
index 8c1d5a90..c5b32424 100644
--- a/app/src/ble.c
+++ b/app/src/ble.c
@@ -44,11 +44,63 @@ LOG_MODULE_DECLARE(zmk, CONFIG_ZMK_LOG_LEVEL);
 
 #define PASSKEY_DIGITS 6
 
-static struct bt_conn *auth_passkey_entry_conn;
+// The connection waiting for the passkey: set at the passkey request (BT RX thread), taken by
+// Enter or Esc (key thread), ended by a failed or cancelled pairing or a disconnect (BT RX
+// thread). Atomic, so exactly one of them drops the reference. Zephyr calls the cancel callback
+// only for a remote Pairing Failed; a local cancel (Esc), the SMP timeout or a disconnect only
+// call pairing_failed, so every one of these paths ends the entry, else it would stay set and
+// keep every key away from the hosts.
+static atomic_ptr_t auth_passkey_entry_conn = ATOMIC_PTR_INIT(NULL);
 // Profile the passkey entry belongs to, set when the passkey is requested.
 static uint8_t auth_passkey_entry_profile;
 RING_BUF_DECLARE(passkey_entries, PASSKEY_DIGITS);
 
+// The pairing that owns the keys: set at the passkey request like auth_passkey_entry_conn, but
+// kept after Enter until the pairing completes, fails, is cancelled or the connection drops, so
+// keys typed while the host checks the passkey (a repeated Enter) do not reach a host either.
+// Set and cleared from the BT RX thread and the system workqueue, read from the key thread.
+static atomic_ptr_t auth_pairing_keys_conn = ATOMIC_PTR_INIT(NULL);
+
+static void auth_pairing_keys_take(struct bt_conn *conn) {
+    struct bt_conn *old = atomic_ptr_set(&auth_pairing_keys_conn, bt_conn_ref(conn));
+
+    if (old) {
+        bt_conn_unref(old);
+    }
+}
+
+// Drops the reference in ptr if it is conn; returns true if it did.
+static bool auth_conn_release(atomic_ptr_t *ptr, struct bt_conn *conn) {
+    struct bt_conn *held = atomic_ptr_get(ptr);
+
+    if (held && held == conn && atomic_ptr_cas(ptr, held, NULL)) {
+        bt_conn_unref(held);
+        return true;
+    }
+    return false;
+}
+
+// The pairing on conn is over (completed, failed, cancelled or disconnected): end the passkey
+// entry and the key ownership. Returns true if either was still held.
+static bool auth_pairing_end(struct bt_conn *conn) {
+    bool entry = auth_conn_release(&auth_passkey_entry_conn, conn);
+    bool keys = auth_conn_release(&auth_pairing_keys_conn, conn);
+
+    if (entry || keys) {
+        LOG_DBG("Pairing over, keys go to the host again");
+    }
+    return entry || keys;
+}
+
+bool zmk_ble_passkey_entry_active(void) {
+    return atomic_ptr_get(&auth_passkey_entry_conn) != NULL ||
+           atomic_ptr_get(&auth_pairing_keys_conn) != NULL;
+}
+
+#else
+
+static inline bool auth_pairing_end(struct bt_conn *conn) { return false; }
+
 #endif /* IS_ENABLED(CONFIG_ZMK_BLE_PASSKEY_ENTRY) */
 
 enum advertising_type {
@@ -590,6 +642,10 @@ static void disconnected(struct bt_conn *conn, uint8_t reason) {
     bt_addr_le_to_str(bt_conn_get_dst(conn), addr, sizeof(addr));
 
     LOG_DBG("Disconnected from %s (reason 0x%02x)", addr, reason);
+    if (auth_pairing_end(conn) && is_conn_peripheral(conn)) {
+        // The host left during the pairing and no pairing_failed ended it first.
+        raise_auth_state_changed(auth_profile_index(conn), ZMK_BLE_AUTH_FAILED, 0);
+    }
 
     bt_conn_get_info(conn, &info);
 
@@ -617,6 +673,7 @@ static void security_changed(struct bt_conn *conn, bt_security_t level, enum bt_
         LOG_DBG("Security changed: %s level %u", addr, level);
     } else {
         LOG_ERR("Security failed: %s level %u err %d", addr, level, err);
+        auth_pairing_end(conn);
         if (is_conn_peripheral(conn)) {
             raise_auth_state_changed(auth_profile_index(conn), ZMK_BLE_AUTH_FAILED, 0);
         }
@@ -658,8 +715,12 @@ static void auth_passkey_entry(struct bt_conn *conn) {
 
     LOG_DBG("Passkey entry requested for %s", addr);
     ring_buf_reset(&passkey_entries);
-    auth_passkey_entry_conn = bt_conn_ref(conn);
+    auth_pairing_keys_take(conn);
     auth_passkey_entry_profile = auth_profile_index(conn);
+    struct bt_conn *old = atomic_ptr_set(&auth_passkey_entry_conn, bt_conn_ref(conn));
+    if (old) {
+        bt_conn_unref(old);
+    }
     raise_auth_state_changed(auth_passkey_entry_profile, ZMK_BLE_AUTH_PASSKEY_REQ, 0);
 }
 
@@ -669,15 +730,7 @@ static void auth_cancel(struct bt_conn *conn) {
     char addr[BT_ADDR_LE_STR_LEN];
 
     bt_addr_le_to_str(bt_conn_get_dst(conn), addr, sizeof(addr));
-
-#if IS_ENABLED(CONFIG_ZMK_BLE_PASSKEY_ENTRY)
-    if (auth_passkey_entry_conn) {
-        bt_conn_unref(auth_passkey_entry_conn);
-        auth_passkey_entry_conn = NULL;
-    }
-
-    ring_buf_reset(&passkey_entries);
-#endif
+    auth_pairing_end(conn);
 
     LOG_DBG("Pairing cancelled: %s", addr);
     if (is_conn_peripheral(conn)) {
@@ -712,6 +765,7 @@ static void auth_pairing_complete(struct bt_conn *conn, bool bonded) {
 
     bt_addr_le_to_str(dst, addr, sizeof(addr));
     bt_conn_get_info(conn, &info);
+    auth_pairing_end(conn);
 
     if (info.role != BT_CONN_ROLE_PERIPHERAL) {
         LOG_DBG("SKIPPING FOR ROLE %d", info.role);
@@ -732,6 +786,7 @@ static void auth_pairing_complete(struct bt_conn *conn, bool bonded) {
 
 static void auth_pairing_failed(struct bt_conn *conn, enum bt_security_err reason) {
     LOG_DBG("Pairing failed: reason %d", reason);
+    auth_pairing_end(conn);
     if (is_conn_peripheral(conn)) {
         raise_auth_state_changed(auth_profile_index(conn), ZMK_BLE_AUTH_FAILED, 0);
     }
@@ -843,7 +898,7 @@ static int zmk_ble_handle_key_user(struct zmk_keycode_state_changed *event) {
 
     LOG_DBG("key %d", key);
 
-    if (!auth_passkey_entry_conn) {
+    if (!atomic_ptr_get(&auth_passkey_entry_conn)) {
         LOG_DBG("No connection for passkey entry");
         return ZMK_EV_EVENT_BUBBLE;
     }
@@ -854,11 +909,21 @@ static int zmk_ble_handle_key_user(struct zmk_keycode_state_changed *event) {
     }
 
     if (key == HID_USAGE_KEY_KEYBOARD_ESCAPE) {
-        bt_conn_auth_cancel(auth_passkey_entry_conn);
+        // Taken first: the local cancel only calls pairing_failed (it raises FAILED).
+        struct bt_conn *conn = atomic_ptr_clear(&auth_passkey_entry_conn);
+        if (conn) {
+            bt_conn_auth_cancel(conn);
+            bt_conn_unref(conn);
+        }
         return ZMK_EV_EVENT_HANDLED;
     }
 
     if (key == HID_USAGE_KEY_KEYBOARD_RETURN || key == HID_USAGE_KEY_KEYBOARD_RETURN_ENTER) {
+        struct bt_conn *conn = atomic_ptr_clear(&auth_passkey_entry_conn);
+        if (!conn) {
+            return ZMK_EV_EVENT_HANDLED; // the pairing ended meanwhile
+        }
+
         uint8_t digits[PASSKEY_DIGITS];
         uint32_t count = ring_buf_get(&passkey_entries, digits, PASSKEY_DIGITS);
 
@@ -870,9 +935,8 @@ static int zmk_ble_handle_key_user(struct zmk_keycode_state_changed *event) {
         LOG_DBG("Final passkey: %d", passkey);
         // Before the entry: the result (FAILED/PAIRED_OK) must queue after it.
         raise_auth_state_changed(auth_passkey_entry_profile, ZMK_BLE_AUTH_PASSKEY_SUBMITTED, 0);
-        bt_conn_auth_passkey_entry(auth_passkey_entry_conn, passkey);
-        bt_conn_unref(auth_passkey_entry_conn);
-        auth_passkey_entry_conn = NULL;
+        bt_conn_auth_passkey_entry(conn, passkey);
+        bt_conn_unref(conn);
         return ZMK_EV_EVENT_HANDLED;
     }
 
@@ -892,8 +956,11 @@ static int zmk_ble_handle_key_user(struct zmk_keycode_state_changed *event) {
     ring_buf_put(&passkey_entries, &val, 1);
     LOG_DBG("value entered: %d, digits collected so far: %d", val,
             ring_buf_size_get(&passkey_entries));
-    raise_auth_state_changed(auth_passkey_entry_profile, ZMK_BLE_AUTH_PASSKEY_DIGITS,
-                             ring_buf_size_get(&passkey_entries));
+    // The BT RX thread may have ended the pairing meanwhile: no guidance after its FAILED.
+    if (atomic_ptr_get(&auth_passkey_entry_conn)) {
+        raise_auth_state_changed(auth_passkey_entry_profile, ZMK_BLE_AUTH_PASSKEY_DIGITS,
+                                 ring_buf_size_get(&passkey_entries));
+    }
 
     return ZMK_EV_EVENT_HANDLED;
 }
diff --git a/app/src/hid_listener.c b/app/src/hid_listener.c
index cd463d8e..245fa8ba 100644
--- a/app/src/hid_listener.c
+++ b/app/src/hid_listener.c
@@ -15,6 +15,24 @@ LOG_MODULE_DECLARE(zmk, CONFIG_ZMK_LOG_LEVEL);
 #include <zmk/hid.h>
 #include <dt-bindings/zmk/hid_usage_pages.h>
 #include <zmk/endpoints.h>
+#if IS_ENABLED(CONFIG_ZMK_BLE)
+#include <zmk/ble.h>
+#endif
+
+// While a passkey is entered, and until the host has checked it, the keys belong to the pairing
+// and must not reach any host (a repeated Enter would). The passkey listener in ble.c sees them
+// only after this one (listeners run in link order), so check here: drop presses, and releases
+// of keys that are not in the report. Releases of keys held from before still go out, so
+// nothing gets stuck. Corner case: if a usage held from before is pressed again on another key
+// position during the entry, that key's release goes out too and ends the held usage early.
+static bool hid_listener_passkey_entry_swallows(const struct zmk_keycode_state_changed *ev) {
+#if IS_ENABLED(CONFIG_ZMK_BLE) && IS_ENABLED(CONFIG_ZMK_BLE_PASSKEY_ENTRY)
+    return zmk_ble_passkey_entry_active() &&
+           (ev->state || !zmk_hid_is_pressed(ZMK_HID_USAGE(ev->usage_page, ev->keycode)));
+#else
+    return false;
+#endif
+}
 
 static int hid_listener_keycode_pressed(const struct zmk_keycode_state_changed *ev) {
     int err, explicit_mods_changed, implicit_mods_changed;
@@ -99,7 +117,9 @@ static int hid_listener_keycode_released(const struct zmk_keycode_state_changed
 int hid_listener(const zmk_event_t *eh) {
     const struct zmk_keycode_state_changed *ev = as_zmk_keycode_state_changed(eh);
     if (ev) {
-        if (ev->state) {
+        if (hid_listener_passkey_entry_swallows(ev)) {
+            LOG_DBG("passkey entry: not reporting keycode 0x%02X", ev->keycode);
+        } else if (ev->state) {
             hid_listener_keycode_pressed(ev);
         } else {
             hid_listener_keycode_released(ev);
-- 
2.53.0

