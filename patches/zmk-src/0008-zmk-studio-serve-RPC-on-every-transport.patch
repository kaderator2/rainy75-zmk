From 0b2bf02a76527ef6ee63ba96d4c9a3c5e4f89f95 Mon Sep 17 00:00:00 2001
From: scholzri <33288574+scholzri@users.noreply.github.com>
Date: Tue, 6 Oct 2026 19:14:35 +0200
Subject: [PATCH] zmk: studio: serve RPC on every transport

ZMK Studio answered only on the transport of the selected output: with
the output on USB a Bluetooth client got no answer, and the other way
round. A keyboard with both a USB port and BLE (and the Studio client
on either) had to switch its output first, which also locked Studio.

Every transport now listens all the time. A transport claims the
shared RX buffer before writing request bytes into it, so two clients
never interleave; another transport can take over once the owner has
been quiet for 200 ms. Responses and notifications go out over the
transport of the last request. With CONFIG_ZMK_STUDIO_LOCK_ON_DISCONNECT
a change of transport locks Studio first, so a client on another
transport never inherits an unlock. The output selection no longer
plays a role for Studio.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 app/include/zmk/studio/rpc.h        |  10 +++
 app/src/studio/gatt_rpc_transport.c |  14 ++--
 app/src/studio/rpc.c                | 126 ++++++++++++++++++----------
 app/src/studio/uart_rpc_transport.c |  13 ++-
 4 files changed, 107 insertions(+), 56 deletions(-)

diff --git a/app/include/zmk/studio/rpc.h b/app/include/zmk/studio/rpc.h
index e223b7a5..29386f6c 100644
--- a/app/include/zmk/studio/rpc.h
+++ b/app/include/zmk/studio/rpc.h
@@ -219,6 +219,16 @@ struct ring_buf *zmk_rpc_get_tx_buf(void);
 struct ring_buf *zmk_rpc_get_rx_buf(void);
 void zmk_rpc_rx_notify(void);
 
+/**
+ * Claim the shared RX buffer before writing request bytes into it. Studio is served on every
+ * transport; the claim keeps two clients from interleaving bytes. Returns false while another
+ * transport is in the middle of a request: drop the bytes then.
+ */
+bool zmk_rpc_rx_claim(enum zmk_transport transport);
+
+/** Whether responses currently go out over this transport (the one of the last request). */
+bool zmk_rpc_transport_is_selected(enum zmk_transport transport);
+
 #define ZMK_RPC_TRANSPORT(name, _transport, _rx_start, _rx_stop, _tx_user_data, _tx_notify)        \
     STRUCT_SECTION_ITERABLE(zmk_rpc_transport, name) = {                                           \
         .transport = _transport,                                                                   \
diff --git a/app/src/studio/gatt_rpc_transport.c b/app/src/studio/gatt_rpc_transport.c
index dff18259..d1af5bf9 100644
--- a/app/src/studio/gatt_rpc_transport.c
+++ b/app/src/studio/gatt_rpc_transport.c
@@ -23,8 +23,6 @@
 
 LOG_MODULE_DECLARE(zmk_studio, CONFIG_ZMK_STUDIO_LOG_LEVEL);
 
-static bool handling_rx = false;
-
 static K_SEM_DEFINE(indicate_sem, 1, 1);
 static atomic_t notify_size;
 
@@ -61,11 +59,15 @@ static ssize_t read_rpc_resp(struct bt_conn *conn, const struct bt_gatt_attr *at
     return 0;
 }
 
+static void refresh_notify_size(void);
+
 static ssize_t write_rpc_req(struct bt_conn *conn, const struct bt_gatt_attr *attr, const void *buf,
                              uint16_t len, uint16_t offset, uint8_t flags) {
-    if (!handling_rx) {
+    if (!zmk_rpc_rx_claim(ZMK_TRANSPORT_BLE)) {
+        // Another transport is in the middle of a request.
         return len;
     }
+    refresh_notify_size();
 
     uint32_t copied = 0;
     struct ring_buf *rpc_buf = zmk_rpc_get_rx_buf();
@@ -117,14 +119,10 @@ static void refresh_notify_size(void) {
 
 static int gatt_start_rx() {
     refresh_notify_size();
-    handling_rx = true;
     return 0;
 }
 
-static int gatt_stop_rx(void) {
-    handling_rx = false;
-    return 0;
-}
+static int gatt_stop_rx(void) { return 0; }
 
 static uint8_t indicate_buffer[27];
 
diff --git a/app/src/studio/rpc.c b/app/src/studio/rpc.c
index e79b5568..2309a8a9 100644
--- a/app/src/studio/rpc.c
+++ b/app/src/studio/rpc.c
@@ -18,7 +18,6 @@ LOG_MODULE_REGISTER(zmk_studio, CONFIG_ZMK_STUDIO_LOG_LEVEL);
 
 #include <zmk/endpoints.h>
 #include <zmk/event_manager.h>
-#include <zmk/events/endpoint_changed.h>
 #include <zmk/studio/core.h>
 #include <zmk/studio/rpc.h>
 
@@ -78,6 +77,79 @@ static enum studio_framing_state rpc_framing_state;
 static K_MUTEX_DEFINE(rpc_transport_mutex);
 static struct zmk_rpc_transport *selected_transport;
 
+// Studio is served on every transport, independent of the selected output. A transport claims
+// the shared RX buffer before writing request bytes into it, so two clients never interleave;
+// another transport can take over once the owner has been quiet for RX_CLAIM_IDLE_MS (a request
+// arrives within a few connection events). Responses and notifications go out over the
+// transport of the last request.
+#define RX_CLAIM_IDLE_MS 200
+
+static struct k_spinlock rx_claim_lock;
+static enum zmk_transport rx_owner;
+static bool rx_owned;
+static int64_t rx_owner_last_ms;
+
+bool zmk_rpc_rx_claim(enum zmk_transport transport) {
+    bool claimed = false;
+    int64_t now = k_uptime_get();
+
+    K_SPINLOCK(&rx_claim_lock) {
+        if (!rx_owned || rx_owner == transport || now - rx_owner_last_ms > RX_CLAIM_IDLE_MS) {
+            rx_owner = transport;
+            rx_owned = true;
+            rx_owner_last_ms = now;
+            claimed = true;
+        }
+    }
+
+    return claimed;
+}
+
+bool zmk_rpc_transport_is_selected(enum zmk_transport transport) {
+    struct zmk_rpc_transport *t = selected_transport;
+
+    return t && t->transport == transport;
+}
+
+static void select_transport_of_request(void) {
+    enum zmk_transport transport;
+    bool owned;
+
+    K_SPINLOCK(&rx_claim_lock) {
+        transport = rx_owner;
+        owned = rx_owned;
+    }
+
+    if (!owned) {
+        return;
+    }
+
+    k_mutex_lock(&rpc_transport_mutex, K_FOREVER);
+
+    if (!selected_transport || selected_transport->transport != transport) {
+        struct zmk_rpc_transport *prev = selected_transport;
+
+        ARG_UNUSED(prev);
+        selected_transport = NULL;
+        STRUCT_SECTION_FOREACH(zmk_rpc_transport, t) {
+            if (t->transport == transport) {
+                selected_transport = t;
+                break;
+            }
+        }
+
+#if IS_ENABLED(CONFIG_ZMK_STUDIO_LOCK_ON_DISCONNECT)
+        // A client on another transport does not inherit an unlock.
+        if (prev) {
+            zmk_studio_core_lock();
+        }
+#endif
+        LOG_DBG("Studio requests now over transport %d", transport);
+    }
+
+    k_mutex_unlock(&rpc_transport_mutex);
+}
+
 struct ring_buf *zmk_rpc_get_rx_buf(void) { return &rpc_rx_buf; }
 
 void zmk_rpc_rx_notify(void) { k_sem_give(&rpc_rx_sem); }
@@ -224,6 +296,7 @@ static void rpc_main(void) {
         rpc_framing_state = FRAMING_STATE_IDLE;
 
         if (status) {
+            select_transport_of_request();
             zmk_studio_Response resp = handle_request(&req);
 
             int err = send_response(&resp);
@@ -242,43 +315,6 @@ static void rpc_main(void) {
 K_THREAD_DEFINE(studio_rpc_thread, CONFIG_ZMK_STUDIO_RPC_THREAD_STACK_SIZE, rpc_main, NULL, NULL,
                 NULL, K_LOWEST_APPLICATION_THREAD_PRIO, 0, 0);
 
-static void refresh_selected_transport(void) {
-    enum zmk_transport transport = zmk_endpoint_get_selected().transport;
-
-    k_mutex_lock(&rpc_transport_mutex, K_FOREVER);
-
-    if (selected_transport && selected_transport->transport == transport) {
-        goto exit_refresh;
-    }
-
-    if (selected_transport) {
-        if (selected_transport->rx_stop) {
-            selected_transport->rx_stop();
-        }
-        selected_transport = NULL;
-#if IS_ENABLED(CONFIG_ZMK_STUDIO_LOCK_ON_DISCONNECT)
-        zmk_studio_core_lock();
-#endif
-    }
-
-    STRUCT_SECTION_FOREACH(zmk_rpc_transport, t) {
-        if (t->transport == transport) {
-            selected_transport = t;
-            if (selected_transport->rx_start) {
-                selected_transport->rx_start();
-            }
-            break;
-        }
-    }
-
-    if (!selected_transport) {
-        LOG_WRN("Failed to select a transport!");
-    }
-
-exit_refresh:
-    k_mutex_unlock(&rpc_transport_mutex);
-}
-
 static int zmk_rpc_init(void) {
     int prev_choice = -1;
     struct zmk_rpc_subsystem *prev_sub = NULL;
@@ -306,7 +342,12 @@ static int zmk_rpc_init(void) {
         prev_sub->handlers_end_index = i - 1;
     }
 
-    refresh_selected_transport();
+    // Every transport listens all the time; responses follow the transport of each request.
+    STRUCT_SECTION_FOREACH(zmk_rpc_transport, t) {
+        if (t->rx_start) {
+            t->rx_start();
+        }
+    }
 
     return 0;
 }
@@ -314,12 +355,6 @@ static int zmk_rpc_init(void) {
 SYS_INIT(zmk_rpc_init, APPLICATION, CONFIG_APPLICATION_INIT_PRIORITY);
 
 static int studio_rpc_listener_cb(const zmk_event_t *eh) {
-    struct zmk_endpoint_changed *ep_changed = as_zmk_endpoint_changed(eh);
-    if (ep_changed) {
-        refresh_selected_transport();
-        return ZMK_EV_EVENT_BUBBLE;
-    }
-
     struct zmk_studio_rpc_notification *rpc_notify = as_zmk_studio_rpc_notification(eh);
     if (rpc_notify) {
         zmk_studio_Response resp = zmk_studio_Response_init_zero;
@@ -343,5 +378,4 @@ static int studio_rpc_listener_cb(const zmk_event_t *eh) {
 }
 
 ZMK_LISTENER(studio_rpc, studio_rpc_listener_cb);
-ZMK_SUBSCRIPTION(studio_rpc, zmk_endpoint_changed);
 ZMK_SUBSCRIPTION(studio_rpc, zmk_studio_rpc_notification);
diff --git a/app/src/studio/uart_rpc_transport.c b/app/src/studio/uart_rpc_transport.c
index d4a4de83..ca2e66f5 100644
--- a/app/src/studio/uart_rpc_transport.c
+++ b/app/src/studio/uart_rpc_transport.c
@@ -100,7 +100,13 @@ static void serial_cb(const struct device *dev, void *user_data) {
         return;
     }
 
-    if (uart_irq_rx_ready(uart_dev)) {
+    if (uart_irq_rx_ready(uart_dev) && !zmk_rpc_rx_claim(ZMK_TRANSPORT_USB)) {
+        /* Another transport is in the middle of a request: drop the bytes. */
+        uint8_t dummy[16];
+
+        while (uart_fifo_read(uart_dev, dummy, sizeof(dummy)) > 0) {
+        }
+    } else if (uart_irq_rx_ready(uart_dev)) {
         /* read until FIFO empty */
         uint32_t last_read = 0, len = 0;
         struct ring_buf *buf = zmk_rpc_get_rx_buf();
@@ -122,7 +128,10 @@ static void serial_cb(const struct device *dev, void *user_data) {
         zmk_rpc_rx_notify();
     }
 
-    if (uart_irq_tx_ready(uart_dev)) {
+    if (uart_irq_tx_ready(uart_dev) && !zmk_rpc_transport_is_selected(ZMK_TRANSPORT_USB)) {
+        /* The shared TX buffer belongs to another transport now. */
+        uart_irq_tx_disable(uart_dev);
+    } else if (uart_irq_tx_ready(uart_dev)) {
         struct ring_buf *tx_buf = zmk_rpc_get_tx_buf();
         uint32_t len;
         while ((len = ring_buf_size_get(tx_buf)) > 0) {
