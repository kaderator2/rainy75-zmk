if BOARD_RAINY75

config SOC_FLASH_TELINK_B91
	default y if FLASH

config WDT_B91
	default y
	depends on WDT

# ---- Multi-level IRQ fix ----
# The PLIC driver selects MULTI_LEVEL_INTERRUPTS + 2ND_LEVEL_INTERRUPTS.
# The B91 SoC defconfig omits MAX_IRQ_PER_AGGREGATOR, leaving it at 0.
# With 0, PLIC_MIN_IRQ_NUM = MIN(riscv_ndev=63, 0) = 0, causing ALL PLIC
# interrupts to be treated as spurious (z_irq_spurious crash).
#
# We also set 2ND_LVL_ISR_TBL_OFFSET=12 to separate the PLIC ISR table
# from level-1 entries (MTIP=7, MEIP=11).  Without this, PLIC source 7
# (USB_SETUP) collides with MTIP, and PLIC source 11 (USB_ENDPOINT)
# collides with MEI (the PLIC handler itself).
#
# The mtimer DTS is overridden in rainy75.dts to use <&hlic 7> so that
# the timer ISR stays at _sw_isr_table[7] (level-1 direct dispatch).
#
# NUM_IRQS = 12 (level-1) + 64 (PLIC sources) = 76.

config MAX_IRQ_PER_AGGREGATOR
	default 64

config 2ND_LVL_ISR_TBL_OFFSET
	default 12

config NUM_IRQS
	default 76

# ---- Kernel tick rate ----
# The machine timer (mtime) runs from the 32 kHz RC, so
# SYS_CLOCK_HW_CYCLES_PER_SEC is 32000 (SoC default). The kernel default tick
# rate for a tickless kernel is 10000, and the riscv machine timer driver uses
# CYC_PER_TICK = 32000 / 10000, an integer division that gives 3 instead of
# 3.2. Every kernel tick was then 93.75 us instead of 100 us: k_uptime_get(),
# k_sleep() and every kernel timeout ran 6.67 % fast against mtime (measured
# +6.6 % against host wall time; debounce, tap-hold, key repeat and the idle
# sleep timeout were all 6.25 % short). One tick per mtime cycle makes the
# division exact and gives the finest timeout resolution (31.25 us).
config SYS_CLOCK_TICKS_PER_SEC
	default 32000

endif # BOARD_RAINY75
