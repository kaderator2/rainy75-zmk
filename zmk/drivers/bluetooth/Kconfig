config BT_HCI_B91
	bool "Telink B91 BLE HCI driver"
	default y
	depends on BT && DT_HAS_TELINK_B91_BT_HCI_ENABLED
	select BT_HAS_HCI_VS if BT_HCI_B91_CTLR_BLOB
	help
	  Bluetooth HCI driver for the Telink B91 (TLSR951x) SoC. The
	  controller behind it is chosen below: either our shim around the
	  BLE controller blob (liblt_9518_zephyr.a) from
	  telink-semi/zephyr_hal_telink_b91_ble_lib, or the open-source link
	  layer in openll/ (experimental, no binary blobs).

config BT_HCI_B91_RX_STACK_SIZE
	int "B91 BLE RX thread stack size"
	depends on BT_HCI_B91
	default 2048

config BT_HCI_B91_RX_PRIO
	int "B91 BLE RX thread priority"
	depends on BT_HCI_B91
	default 2

choice BT_HCI_B91_CONTROLLER
	prompt "B91 BLE controller implementation"
	depends on BT_HCI_B91
	default BT_HCI_B91_CTLR_BLOB

config BT_HCI_B91_CTLR_BLOB
	bool "Telink binary controller (liblt_9518_zephyr.a)"
	help
	  Proprietary controller blob from telink-semi. Full peripheral
	  feature set, but the resulting image may not be redistributed.

config BT_HCI_B91_CTLR_OPEN
	bool "Open-source link layer (experimental)"
	help
	  Our own peripheral-only link layer on hal_telink rf.c: legacy
	  advertising, one connection (CSA#1, 1M PHY, peripheral latency),
	  responder LL control procedures, ACL data and LE link encryption
	  (AES-CCM on the hal AES engine). No binary blobs are linked.

endchoice

config BT_HCI_B91_OPENLL_MAX_CONN
	int "Open link layer: maximum number of peripheral connections"
	depends on BT_HCI_B91_CTLR_OPEN
	range 1 5
	default 1
	help
	  Number of simultaneous peripheral links the open link layer keeps
	  (link ids and HCI connection handles 0..N-1). Multilink is being
	  built up in slice 6a; until it is complete only 1 is supported.

config BT_HCI_B91_OPENLL_STATS_LOG
	bool "Open link layer: periodic radio/connection stats log"
	depends on BT_HCI_B91_CTLR_OPEN
	help
	  Log the radio and connection counters every 2 s (INFO level).
	  Development aid: the timer wakes the CPU and the log lines cost
	  USB/CDC traffic. The counters themselves always exist.
